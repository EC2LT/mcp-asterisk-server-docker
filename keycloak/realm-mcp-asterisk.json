{
  "realm": "mcp-asterisk",
  "enabled": true,
  "displayName": "MCP Asterisk Supervisor",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Accès complet à tous les outils" },
      { "name": "supervisor", "description": "Lecture, analyse et écoute" },
      { "name": "operator", "description": "Lecture seule" }
    ]
  },
  "clients": [
    {
      "clientId": "mcp-agent",
      "name": "MCP Agent",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["supervisor"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "vocal-agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["operator"]
    }
  ]
}
