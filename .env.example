# =====================================================
# Configuration MCP Asterisk Supervisor
# =====================================================
# Copiez ce fichier vers .env puis adaptez les valeurs :
#   cp .env.example .env
#   nano .env
# =====================================================

# --- Asterisk (externe au Docker) ---
# IP ou hostname du serveur Asterisk
# Si Asterisk tourne sur la même machine que Docker, utilisez "host.docker.internal"
ASTERISK_HOST=host.docker.internal
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USER=mcp_user
ASTERISK_ARI_PASSWORD=mcp_secret_password
ASTERISK_ARI_APP=asterisk-vocal-ai

# --- Base CDR (MySQL/MariaDB d'Asterisk) ---
CDR_DB_HOST=host.docker.internal
CDR_DB_PORT=3306
CDR_DB_USER=asterisk
CDR_DB_PASSWORD=asterisk
CDR_DB_NAME=asterisk

# --- Keycloak (dans Docker) ---
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8090
KEYCLOAK_REALM=mcp-asterisk
KEYCLOAK_CLIENT_ID=mcp-agent
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Ollama (dans Docker) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Agent vocal S2S ---
UDP_IP=0.0.0.0
UDP_PORT=5088
# IP de la machine qui héberge Docker (trouvable avec `hostname -I`)
# Asterisk enverra l'audio à cette adresse
HOST_IP=192.168.1.50
PIPER_MODEL=/app/models/fr_FR-siwis-medium.onnx
WHISPER_MODEL=small

# --- Compte de service vocal ---
VOCAL_USERNAME=vocal-agent
VOCAL_PASSWORD=password

# --- Rôle par défaut (dev) ---
MCP_ROLE=admin
